<?xml version="1.0" encoding="utf-8"?>
<!--
  Repository-wide NuGet configuration (applies to every project under this folder).

  - Packages are restored into ApplyWise/packages, next to the solution, instead of the
    per-user cache (%USERPROFILE%\.nuget\packages). That folder is git-ignored and
    rebuilt by `dotnet restore`.
  - <clear /> means only the sources listed here are used, never machine- or user-level
    feeds, so restores give the same result on every developer machine and in CI.
  - Package source mapping pins every package ID to nuget.org. This guards against
    dependency-confusion attacks if a private feed is added later; map private
    prefixes (e.g. "ApplyWise.*") to that feed explicitly.
-->
<configuration>
  <config>
    <!-- Relative paths are resolved from the folder containing this file (repo root). -->
    <add key="globalPackagesFolder" value="ApplyWise/packages" />
  </config>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
