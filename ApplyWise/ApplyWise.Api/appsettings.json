{
  "Database": {
    "CommandTimeoutSeconds": 30,
    "Resilience": {
      "Retry": {
        "MaxRetryCount": 3,
        "MaxRetryDelay": "00:00:05",
        "AdditionalTransientErrorNumbers": []
      },
      "CircuitBreaker": {
        "FailureRatio": 0.5,
        "MinimumThroughput": 10,
        "SamplingDuration": "00:00:30",
        "BreakDuration": "00:00:30"
      },
      "Timeout": {
        "OperationTimeout": "00:00:30"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
